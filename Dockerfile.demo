# Pinned by digest (2026-11, supply chain): a tag is whatever the registry
# serves that day. The document worker and broker images use the same one;
# Dependabot proposes a new digest (.github/dependabot.yml).
FROM python:3.14-slim@sha256:9aaa474097d094040649f2162a627c0049b408f52138d980916788d80f04802f

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

COPY . .

# Install WITHOUT the heavy RAG extras (chromadb, sentence-transformers)
# to stay within Fly.io free tier 256MB RAM. The demo only needs chat + LLM.
# Every file from uv.lock, checked against its hash (as the Dockerfile).
COPY --from=ghcr.io/astral-sh/uv:0.13.6@sha256:af22a52f5eafef3d78e551599d405c02df61919d18028f0cea8eda93bc9986d0 /uv /usr/local/bin/uv
RUN uv export --locked --no-emit-project --format requirements-txt --extra test --group build \
        -o /tmp/kazma-requirements.txt \
    && pip install --no-cache-dir --require-hashes --only-binary :all: -r /tmp/kazma-requirements.txt \
    && pip install --no-cache-dir --no-deps --no-build-isolation -e . \
    && rm /tmp/kazma-requirements.txt

RUN useradd -r -m -d /home/kazma -s /bin/bash kazma \
    && mkdir -p /app/kazma-data \
    && chown -R kazma:kazma /app /home/kazma

USER kazma

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "kazma_ui.app:create_app", "--factory", "--no-proxy-headers", "--host", "0.0.0.0", "--port", "8000", "--timeout-graceful-shutdown", "15"]
