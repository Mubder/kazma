# Pinned by digest (2026-11, supply chain): a tag is whatever the registry
# serves that day. The document worker and broker images use the same one;
# Dependabot proposes a new digest (.github/dependabot.yml).
FROM python:3.11-slim@sha256:9534e5a8e315485d4061ed659af0fd78a284c015f9b73661b41d6bab25604534

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

COPY . .

# Install WITHOUT the heavy RAG extras (chromadb, sentence-transformers)
# to stay within Fly.io free tier 256MB RAM. The demo only needs chat + LLM.
RUN pip install --no-cache-dir -e ".[test]"

RUN useradd -r -m -d /home/kazma -s /bin/bash kazma \
    && mkdir -p /app/kazma-data \
    && chown -R kazma:kazma /app /home/kazma

USER kazma

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "kazma_ui.app:create_app", "--factory", "--no-proxy-headers", "--host", "0.0.0.0", "--port", "8000", "--timeout-graceful-shutdown", "15"]
