{
  "version": 1,
  "description": "Memory V2 golden set — setup turns then query must contain expected substring",
  "cases": [
    {
      "id": "favorite_color",
      "setup": [
        {"role": "user", "content": "Remember my favorite color is teal."}
      ],
      "query": "What color do I like?",
      "expect_contains": ["teal"]
    },
    {
      "id": "lives_in_bridge",
      "setup": [
        {"role": "user", "content": "I just moved to Paris last month."}
      ],
      "query": "where do I live",
      "expect_contains": ["paris"],
      "optional": true
    },
    {
      "id": "multi_hop_work",
      "setup_beliefs": [
        {"subject": "user", "predicate": "works_at", "object": "AcmeCorp"},
        {"subject": "AcmeCorp", "predicate": "located_in", "object": "Paris"}
      ],
      "query": "where does the user company sit",
      "expect_contains": ["paris", "acme"],
      "match_any": true
    },
    {
      "id": "multi_hop_three",
      "setup_beliefs": [
        {"subject": "user", "predicate": "reports_to", "object": "Jordan Lee"},
        {"subject": "Jordan Lee", "predicate": "manages", "object": "Platform Team"},
        {"subject": "Platform Team", "predicate": "owns", "object": "Kazma Gateway"}
      ],
      "query": "what product does my manager team own",
      "expect_contains": ["gateway", "kazma", "platform"],
      "match_any": true
    },
    {
      "id": "preference_stack",
      "setup_beliefs": [
        {"subject": "user", "predicate": "prefers", "object": "dark mode"},
        {"subject": "user", "predicate": "timezone", "object": "Asia/Riyadh"}
      ],
      "query": "what is my timezone preference",
      "expect_contains": ["riyadh", "asia"],
      "match_any": true
    },
    {
      "id": "project_name",
      "setup": [
        {"role": "user", "content": "Remember that Project Orion is our Q4 launch codename."}
      ],
      "query": "what is Project Orion",
      "expect_contains": ["orion", "q4", "launch"],
      "match_any": true,
      "optional": true
    }
  ]
}
