# Kazma Environment Variables
# Copy to .env and fill in your values

# ── Server ──────────────────────────────────────────────────────────
# Default port is 9090 (CLI + kazma.yaml). Windows may block 9090; use
# another free port if bind fails (e.g. 9091).
# KAZMA_PORT=9090
# KAZMA_HOST=127.0.0.1
# Bind 0.0.0.0 only behind a reverse proxy with real auth.
# KAZMA_WORKSPACE=G:/path/to/your/repo

# ── Platform connectors ─────────────────────────────────────────────
# Telegram Bot API token (required for Telegram adapter)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Discord Bot token (optional, for Discord adapter)
DISCORD_BOT_TOKEN=

# Slack Bot token (optional, for Slack adapter)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# ── LLM keys ────────────────────────────────────────────────────────
# Generic fallbacks read by the LLM provider layer:
OPENAI_API_KEY=
KAZMA_API_KEY=
# Active model/provider (optional overrides):
# KAZMA_PROVIDER=openai
# KAZMA_MODEL=gpt-4o-mini
#
# NOTE: DEEPSEEK_API_KEY / ANTHROPIC_API_KEY are NOT read by core code.
# Configure DeepSeek/Anthropic/etc. via Settings → Providers (ConfigStore)
# or the provider list in the UI — not dedicated env vars.

# Google Cloud / Vertex AI (optional — uses ADC, no API key needed)
# Set GOOGLE_CLOUD_PROJECT if ADC doesn't have a default project
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Swarm bot (optional, for dedicated swarm output bot)
SWARM_BOT_TOKEN=
SWARM_CHAT_ID=

# ── Auth / security ─────────────────────────────────────────────────
# Shared secret for sensitive API routes. Auto-generated on loopback if
# unset. Non-loopback bind (0.0.0.0) REQUIRES an explicit strong secret.
# Cookie auto-issued for loopback only; set KAZMA_TRUST_LAN=1 for LAN labs.
# KAZMA_SECRET=your-strong-random-secret-here
# KAZMA_TRUST_LAN=0
# Optional HS256 secret for verified multi-tenant JWT claims:
# KAZMA_JWT_SECRET=

# Production profile (Docker compose sets PRODUCTION=1 by default):
#   - Forces Docker jail for python_exec (no local fallback)
#   - Disables YOLO unless KAZMA_ALLOW_YOLO=1
#   - Stricter shell allowlist
# KAZMA_PRODUCTION=1
# KAZMA_ALLOW_YOLO=0
# KAZMA_CODE_EXEC_DOCKER=force
# KAZMA_WORKSPACE_ROOT=/data/workspaces
# KAZMA_ALLOW_PRIVATE_LLM=0
# KAZMA_PUBLIC_URL=https://your.domain
# Opaque browser sessions (default on) — cookie is random id, not the secret
# KAZMA_OPAQUE_SESSIONS=1
# KAZMA_SESSION_TTL_SECONDS=1209600
# KAZMA_TURN_TIMEOUT_SECONDS=600
# KAZMA_MCP_SAFE_ALLOWLIST=read_file,list_dir
# KAZMA_SEMANTIC_CACHE_TTL_SECONDS=86400
# KAZMA_SEMANTIC_CACHE_MAX_ROWS=10000

# ── Multi-replica / Postgres (Phase 4.3) ────────────────────────────
# Do NOT share SQLite files across replicas. Use Postgres instead:
# KAZMA_DATABASE_URL=postgresql://kazma:pass@db:5432/kazma
# KAZMA_DB_BACKEND=postgres
# KAZMA_PG_POOL_MIN=1
# KAZMA_PG_POOL_MAX=10
# pip install -e ".[postgres]"

# ── Multi-user / OIDC (Phase 4.4) ───────────────────────────────────
# KAZMA_MULTI_USER=1
# Local users are stored under ConfigStore key platform.users
# OIDC (optional):
# KAZMA_OIDC_ISSUER=https://accounts.example.com
# KAZMA_OIDC_CLIENT_ID=
# KAZMA_OIDC_CLIENT_SECRET=
# KAZMA_OIDC_REDIRECT_URI=https://your.domain/api/auth/oidc/callback
# KAZMA_OIDC_DEFAULT_ROLE=operator

# Encrypted Secret Vault (auto-generated on first startup if not set)
# Required for production: secrets stay out of plaintext settings.db
# KAZMA_VAULT_KEY=your-vault-encryption-key-here

# ── Vector memory / embeddings ──────────────────────────────────────
# KAZMA_VECTOR_PATH=~/.kazma/vector_memory
# KAZMA_VECTOR_COLLECTION=agent_memory
# Default is local BAAI/bge-m3 (1024-dim, multilingual). Overrides:
# KAZMA_EMBED_PROVIDER=local
# KAZMA_EMBED_MODEL=BAAI/bge-m3
# KAZMA_EMBED_DIM=1024
# NVIDIA NIM / OpenAI-compatible embeddings (see kazma.yaml memory.embedding):
# KAZMA_EMBED_API_KEY=nvapi-xxxxxxxx

# ── Git bot identity (optional) ─────────────────────────────────────
# KAZMA_BOT_NAME=Kazma Agent
# KAZMA_BOT_EMAIL=kazma-agent[bot]@users.noreply.github.com

# ── GitHub (optional) ───────────────────────────────────────────────
# Option A — OAuth App ("Connect GitHub" button on Workspace):
#   1. https://github.com/settings/developers → New OAuth App
#   2. Authorization callback URL must match your host, e.g.:
#        http://127.0.0.1:9090/api/github/oauth/callback
#        http://172.x.x.x:9090/api/github/oauth/callback   (if using LAN IP)
#   3. Paste Client ID + Client secret here, restart Kazma.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
#
# Option B — Personal Access Token (no OAuth App; paste on Workspace page):
#   https://github.com/settings/tokens  (classic, scope: repo)
# GITHUB_TOKEN=

# ── code_exec sandbox ───────────────────────────────────────────────
# Prefer Docker jail when docker CLI is available (network=none, memory cap).
# auto | 1 | 0   (default: auto)
# KAZMA_CODE_EXEC_DOCKER=auto
# Image used for the jail (must include python):
# KAZMA_CODE_EXEC_IMAGE=python:3.12-slim


# ── Reverse proxy (REQUIRED when a proxy fronts Kazma) ──────────────────
# Address the proxy connects FROM: 127.0.0.1 for same-host nginx/Caddy, or the
# container/bridge IP under Docker. Only these peers may set X-Forwarded-For.
#
# Leave EMPTY when Kazma owns its socket directly. When set, Kazma stops
# treating peer address as a credential — without it, a same-host proxy makes
# every internet visitor look like 127.0.0.1 and get an admin session
# (audit F-01).
KAZMA_TRUSTED_PROXIES=

# Escape hatch: allow credential-less loopback auto-login even with a proxy
# declared. Only for a machine where 127.0.0.1 really is just you.
KAZMA_LOOPBACK_AUTOLOGIN=0


# ════════════════════════════════════════════════════════════════════════
# Security switches — every one of these WEAKENS a default. None is needed
# for normal operation; they are listed so an operator can find them, and
# so a reviewer can grep an install for them.
#
# Until the 2026-09-16 audit this file documented 43 of the 272 KAZMA_*
# variables the code reads, and none of the sixteen below. An undiscoverable
# safety switch is one nobody can audit — including the person who set it.
# ════════════════════════════════════════════════════════════════════════

# ── Authentication ──────────────────────────────────────────────────────
# Disable ALL API authentication. Blocked together with KAZMA_PRODUCTION.
# KAZMA_AUTH_DISABLED=0
# Full-open demo posture (also disables auth). Logs a loud warning once.
# KAZMA_DEMO_MODE=0
# Skip WebSocket auth for local testing. Refused when KAZMA_PRODUCTION=1.
# KAZMA_DEV_WS_BYPASS=0
# Hosts allowed to auto-login without a credential. Empty is correct
# unless you know exactly why it is not.
# KAZMA_AUTOLOGIN_HOSTS=

# ── HITL / approvals ────────────────────────────────────────────────────
# The canonical danger-tool floor is ON by default: the effective
# require_approval_for list can never be narrower than
# CANONICAL_DANGER_TOOLS. Setting 0 lets Settings/YAML narrow it (the tools
# stay gated by their TOOL_TIERS tier, but the graph interrupt and swarm bus
# read the effective list directly). Audit 2026-09-16 F-5.
# KAZMA_HITL_CANONICAL_FLOOR=1
# How long a YOLO (approval-off) window lasts, in seconds.
# KAZMA_YOLO_TTL_SECONDS=
# Comma-separated admin identities (`12345` or `telegram:12345`). When set
# this is AUTHORITATIVE: platform allowlist membership no longer implies
# admin. Admin is required to install packages, change global config, and
# — since audit 2026-09-16 F-8 — to ANSWER AN APPROVAL. Set this whenever
# more than one person can talk to the bot.
# KAZMA_GATEWAY_ADMINS=
# Refuse any chat from a user not on the platform allowlist.
# KAZMA_GATEWAY_STRICT_ALLOWLIST=0

# ── Tool sandboxing ─────────────────────────────────────────────────────
# Let shell_exec mutate files (off in multi-user/production by default).
# KAZMA_SHELL_ALLOW_MUTATE=0
# Let shell_exec run archive/extract commands.
# KAZMA_SHELL_ALLOW_ARCHIVE=0
# Allow code_exec to run on the host instead of a Docker/E2B jail.
# KAZMA_CODE_EXEC_ALLOW_LOCAL=0

# ── MCP ─────────────────────────────────────────────────────────────────
# Expose danger tools over the MCP bridge with NO verified approval path.
# KAZMA_MCP_ALLOW_UNGATED=0
# Treat configured MCP servers as trusted in a production posture.
# KAZMA_MCP_TRUSTED_IN_PROD=0
# Comma-separated MCP tool names that may run without HITL. Empty (the
# default) means every MCP tool is gated, including names that look like
# reads (`read_env`, `get_file`). Tool names are supplied by the server.
# KAZMA_MCP_SAFE_ALLOWLIST=

# ── Misc ────────────────────────────────────────────────────────────────
# Enable the chaos-injection endpoints. Never in production.
# KAZMA_CHAOS_ENABLED=0
# Turn off the runaway-spend circuit breaker.
# KAZMA_DISABLE_COST_BREAKER=0

# ── Hardening (opt-in; these TIGHTEN a default) ─────────────────────────
# Restrict which hosts the `execute_db_query` tool may connect to for
# Postgres/MySQL/MongoDB URIs. Loopback is always allowed. Any other host
# is refused unless listed here (comma-separated). Queries stay SELECT/WITH
# either way.
# KAZMA_DB_CLIENT_ALLOWED_HOSTS=
# Refuse the plaintext-FTP fallback for offsite backups (FTPS is always tried
# first). Without it a server that cannot do AUTH TLS gets a loud warning and
# a cleartext upload of the whole archive.
# backups.offsite.ftp.require_tls is a kazma.yaml / Settings key, not an env
# var — listed here so it is findable alongside the rest.

# Auto-reply to X posts Kazma is summoned under. Off by default; needs a
# PAID X tier for the mentions poller (Free cannot read the timeline).
# Everything below lives in ConfigStore (Settings -> X), not here — these
# two are the kill switches.
# KAZMA_X_REPLY=0        # hard-off, overrides connectors.x.reply.enabled
# KAZMA_X_POST=0         # already disables every write, replies included
