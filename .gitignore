.ruff_cache/

# Local cert/soak/scratch from scripts (e.g. certify_documents.py)
session-artifacts/

# Distribution / packaging
*.tar.gz
*.whl

# Environment variables
.env
.env.local
*.env.*

# Docusaurus (docs site)
docs/node_modules/
docs/.docusaurus/
docs/build/

# Compiled and binary files
*.class
*.o
*.exe
*.dll
*.so
*.a
*.obj
*.out

# Pytest temp directories (generated by test runs, never commit)
.pytest-tmp*/
.pytest_tmp*/
.pytest_temp*/

# Runtime data (generated per-installation, never commit)
kazma-data/
.kazma/
swarm_registry.json

# Machine-local config overrides (never commit — use Settings UI or this file)
# Shipped defaults stay in tracked kazma.yaml; edit this for local ports/tokens.
kazma.local.yaml
*.local.yaml

# SQLite WAL/SHM files (transient, never commit)
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm

# Kubernetes secrets (never commit credentials)

# Research / smoke scratch (not production)
research/kb/

# Generated document demos (regenerable artifacts, not source)
demo_documents/

# Test artifact from tests/test_tool_arg_validation.py (file_write demo)
hello.html

# Transient document intelligence outputs, reports, and UX previews
document_output_*
ux-rework-preview*
reports/
research/reports/

# AgentDojo benchmark (scripts/agentdojo_bench.py) -- deliberately not a
# Kazma dependency, so it gets its own venv and its own run logs.
.venv-agentdojo/
.agentdojo-runs/
.agentdojo-*/

# Runtime output of a live install. A `git add -A` in an operator's clone
# staged 558 of these on 2026-09-19, including kazma-backups/*/dbs/vault.db
# (the live encrypted vault), settings.db, chat_sessions.db and patient
# PDFs. None of it is source; none of it may enter history.
kazma-backups/
extracted_images/
out/

# Vendored tree carrying its own .git -- `git add -A` turns it into a
# broken gitlink rather than files (the vendor report's R5 `core/`).
core/

# pytest scratch. The second pattern catches a tmp root whose path
# separators were stripped, so it lands in the repo root as one name.
pytest-of-*/
*pytest-tmp-hook/
*.pre_reembed

# Playwright evidence from the unified-turn browser suite: traces and
# screenshots on failure, plus the four-gate recording that is the
# release evidence (docs/plans/UNIFIED_TURN_BLOCK.md §13). Uploaded by
# CI, never committed.
test-artifacts/
