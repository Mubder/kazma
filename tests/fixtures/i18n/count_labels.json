        "one": "{n} approval",
        "two": "{n} approvals",
        "few": "{n} approvals",
        "many": "{n} approvals",
        "other": "{n} approvals"
      },
      "count_requests": {
        "zero": "{n} requests",
        "one": "{n} request",
        "two": "{n} requests",
        "few": "{n} requests",
        "many": "{n} requests",
        "other": "{n} requests"
      }
    },
