      "count_tools": {
        "zero": "{n} tools",
        "one": "{n} tool",
        "two": "{n} tools",
        "few": "{n} tools",
        "many": "{n} tools",
        "other": "{n} tools"
      },
      "count_steps": {
        "zero": "{n} steps",
        "one": "{n} step",
        "two": "{n} steps",
        "few": "{n} steps",
        "many": "{n} steps",
        "other": "{n} steps"
      },
      "count_approvals": {
